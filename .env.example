# ============================================
# STORYCHECK DEMOCRACY - ENVIRONMENT VARIABLES
# ============================================

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only Supabase Key (DO NOT expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe Configuration
# Get these from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# API Keys Encryption
# Generate with: openssl rand -hex 32
# IMPORTANT: Keep this secret and never commit it!
API_KEYS_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Email Service (e.g., Resend)
# RESEND_API_KEY=re_...
